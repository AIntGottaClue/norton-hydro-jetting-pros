---
const { items, faq = false, ids = false } = Astro.props;
---
<div class="content-list">
  {items.map((item, i) => faq ? (
    <article class="faq-row"><h3>{item.title}</h3><p>{item.text}</p></article>
  ) : (
    <article class="content-item" id={ids ? item.id : undefined}><div class="item-number">{String(i + 1).padStart(2, '0')}</div><div><h3>{item.title}</h3><p>{item.text}</p></div></article>
  ))}
</div>
