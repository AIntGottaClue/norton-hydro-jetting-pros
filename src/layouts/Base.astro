---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, business } from '../lib/site';
import { pageSchema } from '../lib/seo';
import { siteConfig } from '../data/siteConfig';
import { u } from '../lib/utils';
const { title, description, path, crumbs = [], extraSchema = [] } = Astro.props;
const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d3439" />
    <meta name="robots" content={import.meta.env.BASE_URL === "/" ? "index, follow" : "noindex, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4MeasurementId}`}></script>
    <script is:inline define:vars={{ id: siteConfig.ga4MeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', id);
    </script>
    <JsonLd data={pageSchema(path, title, description, crumbs)} />
    {extraSchema.map((s) => <JsonLd data={s} />)}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <a class="sticky-call" href={business.phoneHref} aria-label={`Call ${business.phoneDisplay}`}>
      <span class="sticky-call-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1Z"/></svg></span>
      <span class="sticky-call-text">Call {business.phoneDisplay}</span>
    </a>
    <script>import '../scripts/lead-form.js';</script>
    <script is:inline defer src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id={siteConfig.airchattyTrackingId}></script>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!a) return;
        (typeof window.gtag === 'function' ? window.gtag : function () { (window.dataLayer = window.dataLayer || []).push(arguments); })('event', 'phone_call_tap', { page_path: location.pathname, link_url: a.getAttribute('href'), link_text: (a.textContent || '').trim().slice(0, 60) });
      }, true);
    </script>
  <script is:inline>
(function(){function run(){if(!('IntersectionObserver' in window))return;var forms=document.querySelectorAll('form[data-lead-form]');if(!forms.length)return;var fx=[].filter.call(document.querySelectorAll('body *'),function(e){return getComputedStyle(e).position==='fixed'&&!e.closest('header')&&(e.matches('a[href^="tel:"]')||e.querySelector('a[href^="tel:"]'))&&e.getClientRects().length});if(!fx.length)return;fx.forEach(function(e){e.style.transition='opacity .2s ease'});var vis=new Set();var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){vis.add(x.target)}else{vis.delete(x.target)}});fx.forEach(function(e){e.style.opacity=vis.size?'0':'';e.style.pointerEvents=vis.size?'none':''})});forms.forEach(function(f){io.observe(f)})}if(document.readyState==='complete'){run()}else{window.addEventListener('load',run)}})();
</script>
</body>
</html>

<style is:global>
.hood-area-map{display:block;width:100%;height:400px;margin:24px 0;border-radius:8px}.hood-copy h2{margin-top:36px}.hood-copy h3{margin-top:22px}.hood-copy p,.hood-copy li{line-height:1.75}.hood-copy ul,.hood-copy ol{padding-left:24px}.hood-copy details{padding:16px 0;border-bottom:1px solid #8885}.hood-copy summary{font-weight:600;cursor:pointer}.hood-nearby{display:flex;flex-wrap:wrap;gap:14px;margin:18px 0}.hood-nearby a{border:1px solid #8885;padding:10px 14px;border-radius:6px}.hood-copy a{overflow-wrap:anywhere}
</style>
